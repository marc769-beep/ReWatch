<!-- index.html -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ReWatch - Apple Watches Reacondicionados</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header>
    <h1>ReWatch</h1>
    <nav>
      <a href="#productos">Productos</a>
      <a href="#sobre">Sobre Nosotros</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Apple Watches reacondicionados, como nuevos.</h2>
    <p>100% funcionales, 40% más baratos.</p>
    <a href="#productos" class="btn">Ver catálogo</a>
  </section>

  <section id="productos" class="productos">
    <h3>Nuestros Productos</h3>
    <div class="grid">
      <div class="card">
        <img src="applewatch1.jpg" alt="Apple Watch Series 6">
        <h4>Apple Watch Series 6</h4>
        <p>Desde 199€</p>
        <button>Comprar</button>
      </div>
      <div class="card">
        <img src="applewatch2.jpg" alt="Apple Watch SE">
        <h4>Apple Watch SE</h4>
        <p>Desde 169€</p>
        <button>Comprar</button>
      </div>
      <!-- Añade más productos aquí -->
    </div>
  </section>

  <section id="sobre">
    <h3>¿Por qué ReWatch?</h3>
    <p>Queremos reducir el impacto ecológico ofreciendo dispositivos reacondicionados con garantía, calidad y diseño premium.</p>
  </section>

  <section id="contacto">
    <h3>Contacto</h3>
    <form>
      <input type="text" placeholder="Tu nombre" required>
      <input type="email" placeholder="Tu email" required>
      <textarea placeholder="Tu mensaje" required></textarea>
      <button type="submit">Enviar</button>
    </form>
  </section>

  <footer>
    <p>&copy; 2025 ReWatch. Todos los derechos reservados.</p>
  </footer>
</body>
</html>
